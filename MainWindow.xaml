<Window x:Class="AIOController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supermonitor Watercooler Controller" Height="620" Width="900"
        Background="#0D0D0D" Foreground="White" WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Painel Superior de Configuração e Opções -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Porta COM:" VerticalAlignment="Center" Foreground="#AAA" Margin="0,0,10,0"/>
                <ComboBox x:Name="ComboComPorts" Width="100" Margin="0,0,20,0" SelectionChanged="OnSettingChanged"/>
                <Button x:Name="BtnToggleConnect" Content="Conectar" Width="120" Height="30" 
                        Background="#222" Foreground="#00FF66" BorderBrush="#00FF66" Click="BtnToggleConnect_Click"/>
            </StackPanel>

            <WrapPanel>
                <CheckBox x:Name="ChkStartMinimized" Content="Iniciar minimizado na bandeja do sistema (System Tray)" 
                          Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,20,5" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="ChkCalculatePumpSpeed" Content="Calcular Pump Speed como 1,6x a velocidade da Fan Speed" 
                          Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,20,5" Checked="ChkCalculatePumpSpeed_CheckedChanged" Unchecked="ChkCalculatePumpSpeed_CheckedChanged"/>
            </WrapPanel>
        </StackPanel>

        <!-- Container do Dashboard -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- CARD CPU -->
                <Border Background="#121212" BorderBrush="#D32F2F" BorderThickness="2" CornerRadius="20" Padding="25" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="CPU" FontSize="36" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                        <!-- Círculo de Temperatura CPU -->
                        <Grid Grid.Column="1" HorizontalAlignment="Center">
                            <Ellipse Width="130" Height="130" Stroke="#222" StrokeThickness="10"/>
                            <Ellipse Width="130" Height="130" Stroke="#D32F2F" StrokeThickness="10" StrokeDashArray="3 1" StrokeDashOffset="0"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtCpuTemp" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text=" °C" FontSize="20" Foreground="#D32F2F" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="Temperatura" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Barras e Mapeamento CPU -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                            <!-- Seletores de Mapeamento (Temp CPU | Carga CPU | Bomba | Fan CPU) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ComboCpuTemp" Grid.Column="0" Margin="2" SelectionChanged="OnSensorSelectionChanged"/>
                                <ComboBox x:Name="ComboCpuLoad" Grid.Column="1" Margin="2" SelectionChanged="OnSensorSelectionChanged"/>
                                <ComboBox x:Name="ComboPumpSpeed" Grid.Column="2" Margin="2" SelectionChanged="OnSensorSelectionChanged"/>
                                <ComboBox x:Name="ComboFanSpeed" Grid.Column="3" Margin="2" SelectionChanged="OnSensorSelectionChanged"/>
                            </Grid>

                            <!-- Carga CPU -->
                            <TextBlock Text="Carga do CPU" Foreground="#CCC" Margin="0,5,0,2"/>
                            <Grid>
                                <ProgressBar x:Name="ProgressCpuLoad" Height="12" Background="#222" Foreground="#D32F2F" Maximum="100"/>
                                <TextBlock x:Name="TxtCpuLoad" Text="0 %" Foreground="#D32F2F" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                            </Grid>

                            <!-- Velocidade da Bomba -->
                            <TextBlock Text="Velocidade da Bomba" Foreground="#CCC" Margin="0,10,0,2"/>
                            <Grid>
                                <ProgressBar x:Name="ProgressPumpSpeed" Height="12" Background="#222" Foreground="#D32F2F" Maximum="4500"/>
                                <TextBlock x:Name="TxtPumpSpeed" Text="0 RPM" Foreground="#D32F2F" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                            </Grid>

                            <!-- Velocidade do Fan (CPU) -->
                            <TextBlock Text="Velocidade do CPU Fan" Foreground="#CCC" Margin="0,10,0,2"/>
                            <Grid>
                                <ProgressBar x:Name="ProgressFanSpeed" Height="12" Background="#222" Foreground="#D32F2F" Maximum="3000"/>
                                <TextBlock x:Name="TxtFanSpeed" Text="0 RPM" Foreground="#D32F2F" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD GPU -->
                <Border Background="#121212" BorderBrush="#D32F2F" BorderThickness="2" CornerRadius="20" Padding="25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="GPU" FontSize="36" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                        <!-- Círculo de Temperatura GPU -->
                        <Grid Grid.Column="1" HorizontalAlignment="Center">
                            <Ellipse Width="130" Height="130" Stroke="#222" StrokeThickness="10"/>
                            <Ellipse Width="130" Height="130" Stroke="#D32F2F" StrokeThickness="10"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtGpuTemp" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text=" °C" FontSize="20" Foreground="#D32F2F" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="Temperatura" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Barras e Mapeamento GPU -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                            <!-- Seletores de Mapeamento (Temp GPU | Carga GPU | Fan GPU) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ComboGpuTemp" Grid.Column="0" Margin="2" SelectionChanged="OnSensorSelectionChanged"/>
                                <ComboBox x:Name="ComboGpuLoad" Grid.Column="1" Margin="2" SelectionChanged="OnSensorSelectionChanged"/>
                                <ComboBox x:Name="ComboGpuFanSpeed" Grid.Column="2" Margin="2" SelectionChanged="OnSensorSelectionChanged"/>
                            </Grid>

                            <!-- Carga GPU -->
                            <TextBlock Text="Carga da GPU" Foreground="#CCC" Margin="0,5,0,2"/>
                            <Grid>
                                <ProgressBar x:Name="ProgressGpuLoad" Height="12" Background="#222" Foreground="#D32F2F" Maximum="100"/>
                                <TextBlock x:Name="TxtGpuLoad" Text="0 %" Foreground="#D32F2F" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                            </Grid>

                            <!-- Velocidade do GPU Fan -->
                            <TextBlock Text="Velocidade do Fan GPU" Foreground="#CCC" Margin="0,10,0,2"/>
                            <Grid>
                                <ProgressBar x:Name="ProgressGpuFanSpeed" Height="12" Background="#222" Foreground="#D32F2F" Maximum="3000"/>
                                <TextBlock x:Name="TxtGpuFanSpeed" Text="0 RPM" Foreground="#D32F2F" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra de Status -->
        <StatusBar Grid.Row="2" Background="Transparent" Foreground="#888" Margin="0,10,0,0">
            <StatusBarItem x:Name="StatusText" Content="Aguardando conexão serial..."/>
        </StatusBar>
    </Grid>
</Window>